# Keep the internal connection token local; never paste it into chat.
DATABASE_PATH=data/coaching.sqlite3
NOTION_API_TOKEN=
NOTION_VERSION=2026-03-11
LLM_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=180
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=90
OPENAI_MAX_INPUT_TOKENS=24000
OPENAI_MAX_OUTPUT_TOKENS=4096
SPENDING_LEDGER_PATH=data/spending.sqlite3
BUDGET_USD=5
BUDGET_RESERVE_USD=1

# Optional redacted structural diagnostics, local only; no transcript/model prose.
RETAIN_REJECTED_DIAGNOSTICS=false
REJECTED_DIAGNOSTICS_PATH=data/rejected-diagnostics

# Separate opt-in for a bounded matching attribution fragment only.
RETAIN_REJECTED_ATTRIBUTION_EXCERPT=false
